@model Digital_Scholarship_Management_System_DDAC.Models.ViewModels.ScholarshipEditViewModel

@{
    ViewData["Title"] = "Edit Scholarship Listing";
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">Editing a rejected listing will resubmit it to the moderator for a fresh review.</p>

<form asp-action="EditScholarship" asp-route-id="@Model.ScholarshipId" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="ScholarshipId" />

    <div class="form-group mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 form-group mb-3">
            <label asp-for="MinCgpa" class="form-label"></label>
            <input asp-for="MinCgpa" class="form-control" type="number" step="0.01" />
            <small class="form-text text-muted">Enter 0 if there's no CGPA requirement.</small>
            <span asp-validation-for="MinCgpa" class="text-danger"></span>
        </div>
        <div class="col-md-6 form-group mb-3">
            <label asp-for="MaxHouseholdIncome" class="form-label"></label>
            <input asp-for="MaxHouseholdIncome" class="form-control" type="number" step="0.01" />
            <small class="form-text text-muted">Enter a large number if there's no income requirement.</small>
            <span asp-validation-for="MaxHouseholdIncome" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RequiredProgram" class="form-label"></label>
        <input asp-for="RequiredProgram" class="form-control" />
        <small class="form-text text-muted">Enter "All" if open to any program.</small>
        <span asp-validation-for="RequiredProgram" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 form-group mb-3">
            <label asp-for="Quota" class="form-label"></label>
            <input asp-for="Quota" class="form-control" type="number" />
            <span asp-validation-for="Quota" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-group mb-3">
            <label asp-for="AmountPerRecipient" class="form-label"></label>
            <input asp-for="AmountPerRecipient" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="AmountPerRecipient" class="text-danger"></span>
        </div>
        <div class="col-md-4 form-group mb-3">
            <label asp-for="ApplicationDeadline" class="form-label"></label>
            <input asp-for="ApplicationDeadline" class="form-control" type="date" />
            <span asp-validation-for="ApplicationDeadline" class="text-danger"></span>
        </div>
    </div>

    <h5 class="mt-4">Supporting Documents</h5>
    <p class="text-muted small">Leave a document blank to keep the existing one.</p>

    <div class="form-group mb-3">
        <label asp-for="PolicyFrameworkFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentPolicyFrameworkPath))
        {
            <div><a href="@Model.CurrentPolicyFrameworkPath" target="_blank" class="small">View current file</a></div>
        }
        <input asp-for="PolicyFrameworkFile" class="form-control" type="file" />
        <span asp-validation-for="PolicyFrameworkFile" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="EligibilityCriteriaFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentEligibilityCriteriaPath))
        {
            <div><a href="@Model.CurrentEligibilityCriteriaPath" target="_blank" class="small">View current file</a></div>
        }
        <input asp-for="EligibilityCriteriaFile" class="form-control" type="file" />
        <span asp-validation-for="EligibilityCriteriaFile" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="AllocationBudgetFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentAllocationBudgetPath))
        {
            <div><a href="@Model.CurrentAllocationBudgetPath" target="_blank" class="small">View current file</a></div>
        }
        <input asp-for="AllocationBudgetFile" class="form-control" type="file" />
        <span asp-validation-for="AllocationBudgetFile" class="text-danger"></span>
    </div>
    <div class="form-group mb-4">
        <label asp-for="PrivacyPolicyFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.CurrentPrivacyPolicyPath))
        {
            <div><a href="@Model.CurrentPrivacyPolicyPath" target="_blank" class="small">View current file</a></div>
        }
        <input asp-for="PrivacyPolicyFile" class="form-control" type="file" />
        <span asp-validation-for="PrivacyPolicyFile" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
