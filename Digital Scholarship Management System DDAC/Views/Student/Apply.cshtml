@model Digital_Scholarship_Management_System_DDAC.Models.ViewModels.ApplicationSubmissionViewModel

@{
    ViewData["Title"] = "Submit Scholarship Application";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">Scholarship Application</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-secondary mb-4">
                <small class="text-uppercase text-muted fw-bold d-block">Applying For:</small>
                <h5 class="mb-0 text-primary">@Model.ScholarshipTitle</h5>
            </div>

            @{
                var scholarship = ViewBag.Scholarship as Digital_Scholarship_Management_System_DDAC.Models.Scholarship;
            }
            @if (scholarship != null)
            {
                <div class="alert alert-light border mb-4">
                    <small class="text-uppercase text-muted fw-bold d-block mb-2">Institution's Supporting Documents</small>
                    <ul class="mb-0 small">
                        @if (!string.IsNullOrEmpty(scholarship.PolicyFrameworkDocumentPath))
                        {
                            <li><a href="@scholarship.PolicyFrameworkDocumentPath" target="_blank">Scholarship Policy Framework</a></li>
                        }
                        @if (!string.IsNullOrEmpty(scholarship.EligibilityCriteriaDocumentPath))
                        {
                            <li><a href="@scholarship.EligibilityCriteriaDocumentPath" target="_blank">Eligibility and Assessment Criteria</a></li>
                        }
                        @if (!string.IsNullOrEmpty(scholarship.AllocationBudgetDocumentPath))
                        {
                            <li><a href="@scholarship.AllocationBudgetDocumentPath" target="_blank">Allocation and Disbursement Budget</a></li>
                        }
                        @if (!string.IsNullOrEmpty(scholarship.PrivacyPolicyDocumentPath))
                        {
                            <li><a href="@scholarship.PrivacyPolicyDocumentPath" target="_blank">Data Protection and Privacy Policy</a></li>
                        }
                    </ul>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <p class="text-muted small">All four documents below are required to submit your application.</p>

            <form asp-controller="Student" asp-action="SubmitApplication" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ScholarshipId" />
                <input type="hidden" asp-for="ScholarshipTitle" />

                <div class="mb-3">
                    <label asp-for="TranscriptFile" class="form-label fw-bold">Academic Transcript</label>
                    <div class="input-group">
                        <input asp-for="TranscriptFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" data-clearable-file required />
                        <button type="button" class="btn btn-outline-secondary" data-clear-file title="Remove selected file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="TranscriptFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="IncomeProofFile" class="form-label fw-bold">Proof of Household Income</label>
                    <div class="input-group">
                        <input asp-for="IncomeProofFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" data-clearable-file required />
                        <button type="button" class="btn btn-outline-secondary" data-clear-file title="Remove selected file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="IncomeProofFile" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CertificateFile" class="form-label fw-bold">Achievement Certificate</label>
                    <div class="input-group">
                        <input asp-for="CertificateFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" data-clearable-file required />
                        <button type="button" class="btn btn-outline-secondary" data-clear-file title="Remove selected file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CertificateFile" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="IdCardFile" class="form-label fw-bold">Identity Card</label>
                    <div class="input-group">
                        <input asp-for="IdCardFile" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" data-clearable-file required />
                        <button type="button" class="btn btn-outline-secondary" data-clear-file title="Remove selected file">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <span asp-validation-for="IdCardFile" class="text-danger"></span>
                    <div class="form-text">Accepted formats: .pdf, .jpg, .png (Max file size: 5MB each)</div>
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success px-4">Submit Application</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-clear-file]').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = button.closest('.input-group').querySelector('[data-clearable-file]');
                if (input) {
                    input.value = '';
                }
            });
        });
    </script>
}
