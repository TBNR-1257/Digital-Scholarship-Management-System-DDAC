@model IEnumerable<Digital_Scholarship_Management_System_DDAC.Models.ViewModels.ApplicationTrackerViewModel>

@{
    ViewData["Title"] = "Application Status Tracker";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-journal-check text-primary me-2"></i>My Applications Tracker</h2>
        <a asp-controller="Student" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search me-1"></i>Find More Scholarships
        </a>
    </div>

    <!-- Success Alert Banner -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Error Alert Banner -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <i class="bi bi-inbox display-6 d-block mb-2 text-warning"></i>
            <h5>No submitted applications found.</h5>
            <p class="mb-0">Head over to your dashboard to view eligible scholarships and submit an application.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Scholarship Title</th>
                                <th>Date Submitted</th>
                                <th>Application Status</th>
                                <th>Supporting Documents</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        @app.ScholarshipTitle
                                        @if (app.ScholarshipStatus == "Closed")
                                        {
                                            <span class="badge bg-secondary ms-1">Listing Closed/Expired</span>
                                        }
                                    </td>
                                    <td>@(app.SubmittedAt.HasValue ? app.SubmittedAt.Value.ToString("dd MMM yyyy, hh:mm tt") : "Draft")</td>
                                    <td>
                                        @if (app.Status == "Approved")
                                        {
                                            <span class="badge bg-success px-3 py-2">Approved</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger px-3 py-2">Rejected</span>
                                        }
                                        else if (app.Status == "UnderReview")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2">Under Review</span>
                                        }
                                        else if (app.Status == "Incomplete")
                                        {
                                            <span class="badge bg-secondary px-3 py-2">Incomplete</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Submitted</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!app.Documents.Any())
                                        {
                                            <span class="text-muted">No documents attached</span>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled mb-0 small">
                                                @foreach (var doc in app.Documents)
                                                {
                                                    <li class="mb-1">
                                                        <a href="@doc.FilePath" target="_blank">
                                                            <i class="bi bi-file-earmark-pdf me-1"></i>@doc.DocumentTypeLabel
                                                        </a>
                                                        @if (doc.VerificationStatus == "Verified")
                                                        {
                                                            <span class="text-success"><i class="bi bi-check-circle ms-1"></i></span>
                                                        }
                                                        else if (doc.VerificationStatus == "Rejected")
                                                        {
                                                            <span class="text-danger"><i class="bi bi-x-circle ms-1"></i></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted"><i class="bi bi-clock ms-1"></i></span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex flex-column gap-1 align-items-center">
                                            @if (app.CanEdit)
                                            {
                                                <a asp-controller="Student" asp-action="EditApplication" asp-route-applicationId="@app.ApplicationId" class="btn btn-sm btn-outline-primary w-100">
                                                    <i class="bi bi-pencil-square me-1"></i>Edit
                                                </a>
                                            }

                                            <!-- Withdraw Button & Form -->
                                            <form asp-controller="Student" asp-action="WithdrawApplication" method="post" class="w-100"
                                                  onsubmit="return confirm('Are you sure you want to withdraw your application for \'@app.ScholarshipTitle\'? This will permanently delete your application and uploaded documents.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="applicationId" value="@app.ApplicationId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                    <i class="bi bi-trash me-1"></i>Withdraw
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
