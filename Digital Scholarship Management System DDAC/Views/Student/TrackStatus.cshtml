@model IEnumerable<Digital_Scholarship_Management_System_DDAC.Models.ViewModels.ApplicationTrackerViewModel>

@{
    ViewData["Title"] = "Application Status Tracker";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Applications Tracker</h2>
        <a asp-controller="Student" asp-action="Index" class="btn btn-primary">Find More Scholarships</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <h5>No submitted applications found.</h5>
            <p class="mb-0">Head over to your dashboard to view eligible scholarships and submit an application.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Scholarship Title</th>
                                <th>Date Submitted</th>
                                <th>Application Status</th>
                                <th>Supporting Document</th>
                                <th>Document Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@app.ScholarshipTitle</td>
                                    <td>@(app.SubmittedAt.HasValue ? app.SubmittedAt.Value.ToString("dd MMM yyyy, hh:mm tt") : "Draft")</td>
                                    <td>
                                        @if (app.Status == "Approved")
                                        {
                                            <span class="badge bg-success px-3 py-2">Approved</span>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger px-3 py-2">Rejected</span>
                                        }
                                        else if (app.Status == "UnderReview")
                                        {
                                            <span class="badge bg-info text-dark px-3 py-2">Under Review</span>
                                        }
                                        else if (app.Status == "Incomplete")
                                        {
                                            <span class="badge bg-secondary px-3 py-2">Incomplete</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Submitted</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(app.DocumentPath))
                                        {
                                            <a href="@app.DocumentPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                View Upload (@app.DocumentType)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No document attached</span>
                                        }
                                    </td>
                                    <td>
                                        @if (app.VerificationStatus == "Verified")
                                        {
                                            <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i>Verified</span>
                                        }
                                        else if (app.VerificationStatus == "Rejected")
                                        {
                                            <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-clock me-1"></i>Pending Review</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>