@model Digital_Scholarship_Management_System_DDAC.Models.ViewModels.EditUserRoleViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit User Role";
}

<div class="container mt-4">
    <h2>Edit User Role</h2>

    <div class="card shadow-sm border-0" style="max-width: 500px;">
        <div class="card-body">
            <form id="edit-role-form" asp-controller="Admin" asp-action="EditUserRole" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" value="@Model.FullName" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" value="@Model.Email" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="SelectedRole" class="form-label"></label>
                    <select asp-for="SelectedRole" class="form-select" asp-items="@(new SelectList(Model.AvailableRoles))"></select>
                    <span asp-validation-for="SelectedRole" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
