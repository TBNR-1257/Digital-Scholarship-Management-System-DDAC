@model Digital_Scholarship_Management_System_DDAC.Models.ViewModels.CategoryInputViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Add Category" : "Edit Category";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <div class="card shadow-sm border-0" style="max-width: 500px;">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="CategoryForm" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-controller="Admin" asp-action="Categories" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
