@model IEnumerable<Digital_Scholarship_Management_System_DDAC.Models.NotificationTemplate>

@{
    ViewData["Title"] = "Notification Templates";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Notification Templates</h2>
        <div>
            <a asp-controller="Admin" asp-action="CreateNotificationTemplate" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Add Template
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <h5>No notification templates yet.</h5>
            <p class="mb-0">Add one to get started.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Subject</th>
                                <th>Last Updated</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@template.Name</td>
                                    <td>@template.Subject</td>
                                    <td>@template.UpdatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        <a asp-controller="Admin" asp-action="EditNotificationTemplate" asp-route-id="@template.NotificationTemplateId" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil-square me-1"></i>Edit
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeleteNotificationTemplate" asp-route-id="@template.NotificationTemplateId" method="post" class="d-inline" onsubmit="return confirm('Delete template &quot;@template.Name&quot;?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
