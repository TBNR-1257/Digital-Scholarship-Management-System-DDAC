@model IEnumerable<Digital_Scholarship_Management_System_DDAC.Models.ViewModels.InstitutionListItemViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Institution Activation";
    var statusFilter = ViewBag.StatusFilter as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Institution Activation</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="Institutions" method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="statusFilter" class="form-select" asp-items="@(new SelectList(new[] { "PendingModeratorReview", "PendingAdminActivation", "Active", "Rejected" }, statusFilter))">
                        <option value="">All statuses</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                    @if (!string.IsNullOrWhiteSpace(statusFilter))
                    {
                        <a asp-controller="Admin" asp-action="Institutions" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <h5>No institutions found.</h5>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Institution</th>
                                <th>Contact</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var institution in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@institution.InstitutionName</td>
                                    <td>
                                        @(institution.ContactEmail ?? "-")<br />
                                        <span class="text-muted">@(institution.ContactPhone ?? "")</span>
                                    </td>
                                    <td>
                                        @if (institution.VerificationStatus == "Active")
                                        {
                                            <span class="badge bg-success px-3 py-2">Active</span>
                                        }
                                        else if (institution.VerificationStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger px-3 py-2">Rejected</span>
                                        }
                                        else if (institution.VerificationStatus == "PendingAdminActivation")
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Pending Admin Activation</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2">Pending Moderator Review</span>
                                        }
                                    </td>
                                    <td>
                                        @if (institution.VerificationStatus == "Rejected" && !string.IsNullOrWhiteSpace(institution.RejectionReason))
                                        {
                                            <span class="text-danger">@institution.RejectionReason</span>
                                        }
                                        else if (institution.ActivatedAt.HasValue)
                                        {
                                            <span class="text-muted">Activated @institution.ActivatedAt.Value.ToString("dd MMM yyyy")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (institution.VerificationStatus == "PendingAdminActivation")
                                        {
                                            <form asp-controller="Admin" asp-action="ActivateInstitution" asp-route-id="@institution.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success me-1">
                                                    <i class="bi bi-check-circle me-1"></i>Activate
                                                </button>
                                            </form>
                                            <a asp-controller="Admin" asp-action="RejectInstitution" asp-route-id="@institution.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-x-circle me-1"></i>Reject
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No action needed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
