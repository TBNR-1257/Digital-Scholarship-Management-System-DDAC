@model Digital_Scholarship_Management_System_DDAC.Models.ViewModels.AdminUsersPageViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Manage Users</h2>
        <div>
            <a asp-controller="Admin" asp-action="CreateStaffUser" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i>Add Staff Account
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form asp-controller="Admin" asp-action="Users" method="get" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Search by name or email</label>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="e.g. Demo Student, admin@ddac.edu" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Role</label>
                    <select name="roleFilter" class="form-select" asp-items="@(new SelectList(Model.AvailableRoles, Model.RoleFilter))">
                        <option value="">All roles</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.RoleFilter))
                    {
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Users.Any())
    {
        <div class="alert alert-warning text-center py-4 shadow-sm">
            <h5>No users match your search.</h5>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="fw-bold">@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td><span class="badge bg-primary px-3 py-2">@user.Role</span></td>
                                    <td>
                                        @if (user.IsLockedOut)
                                        {
                                            <span class="badge bg-danger px-3 py-2">Disabled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success px-3 py-2">Active</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Admin" asp-action="EditUserRole" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil-square me-1"></i>Edit Role
                                        </a>
                                        <form asp-controller="Admin" asp-action="ToggleLockout" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @if (user.IsLockedOut)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-unlock me-1"></i>Enable
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-lock me-1"></i>Disable
                                                </button>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
