@model IEnumerable<Digital_Scholarship_Management_System_DDAC.Models.Scholarship>

@{
    ViewData["Title"] = "Scholarship Listings";
    string? search = ViewBag.Search;
    string? statusFilter = ViewBag.StatusFilter;
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Scholarship Listings</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <form asp-action="Listings" method="get" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Search by title or institution</label>
                    <input type="text" name="search" value="@search" class="form-control" placeholder="e.g. Excellence Award" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(statusFilter))">All</option>
                        <option value="Pending" selected="@(statusFilter == "Pending")">Pending Approval</option>
                        <option value="Open" selected="@(statusFilter == "Open")">Approved &ndash; Open</option>
                        <option value="Closed" selected="@(statusFilter == "Closed")">Closed</option>
                        <option value="Rejected" selected="@(statusFilter == "Rejected")">Rejected</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="bi bi-search me-1"></i>Filter
                    </button>
                    @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(statusFilter))
                    {
                        <a asp-action="Listings" class="btn btn-outline-secondary">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4 shadow-sm">
            <h5>No listings match your search.</h5>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>Institution</th>
                                <th>Quota</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Title</td>
                                    <td>@(item.InstitutionName ?? "Unknown")</td>
                                    <td>@item.Quota</td>
                                    <td>@(item.ApplicationDeadline.HasValue ? item.ApplicationDeadline.Value.ToString("dd MMM yyyy") : "None")</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                                                break;
                                            case "Open":
                                                <span class="badge bg-success px-3 py-2">Open</span>
                                                break;
                                            case "Closed":
                                                <span class="badge bg-secondary px-3 py-2">Closed</span>
                                                break;
                                            case "Rejected":
                                                <span class="badge bg-danger px-3 py-2">Rejected</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary px-3 py-2">@item.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ListingDetails" asp-route-id="@item.ScholarshipId" class="btn btn-sm btn-primary">
                                            @(item.Status == "Pending" ? "Review" : "View")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
