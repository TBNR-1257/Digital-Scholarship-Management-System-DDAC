@model Digital_Scholarship_Management_System_DDAC.Models.InstitutionProfile

@{
    ViewData["Title"] = "Review Institution";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Institution Details</h2>
        <a asp-action="Institutions" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Institution Name</dt>
                <dd class="col-sm-8">@Model.InstitutionName</dd>

                <dt class="col-sm-4">Account Email</dt>
                <dd class="col-sm-8">@(ViewBag.AccountEmail ?? "Unknown")</dd>

                <dt class="col-sm-4">Contact Email</dt>
                <dd class="col-sm-8">@(Model.ContactEmail ?? "Not provided")</dd>

                <dt class="col-sm-4">Contact Phone</dt>
                <dd class="col-sm-8">@(Model.ContactPhone ?? "Not provided")</dd>

                <dt class="col-sm-4">Registration Document</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.RegistrationDocumentPath))
                    {
                        <a href="@Model.RegistrationDocumentPath" target="_blank">View Document</a>
                    }
                    else
                    {
                        <span class="text-muted">None uploaded</span>
                    }
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @switch (Model.VerificationStatus)
                    {
                        case "PendingModeratorReview":
                            <span class="badge bg-warning text-dark px-3 py-2">Pending Review</span>
                            break;
                        case "PendingAdminActivation":
                            <span class="badge bg-info text-dark px-3 py-2">Approved &ndash; Awaiting Admin</span>
                            break;
                        case "Active":
                            <span class="badge bg-success px-3 py-2">Active</span>
                            break;
                        case "Rejected":
                            <span class="badge bg-danger px-3 py-2">Rejected</span>
                            break;
                    }
                </dd>

                @if (Model.ModeratedAt.HasValue)
                {
                    <dt class="col-sm-4">Reviewed At</dt>
                    <dd class="col-sm-8">@Model.ModeratedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</dd>
                }

                @if (Model.VerificationStatus == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
                {
                    <dt class="col-sm-4">Rejection Reason</dt>
                    <dd class="col-sm-8 text-danger">@Model.RejectionReason</dd>
                }
            </dl>
        </div>
    </div>

    @if (Model.VerificationStatus == "PendingModeratorReview")
    {
        <div class="row g-3">
            <div class="col-md-6">
                <form asp-action="ApproveInstitution" method="post">
                    <input type="hidden" name="id" value="@Model.InstitutionProfileId" />
                    <button type="submit" class="btn btn-success w-100">Approve Institution</button>
                </form>
            </div>
            <div class="col-md-6">
                <form asp-action="RejectInstitution" method="post">
                    <input type="hidden" name="id" value="@Model.InstitutionProfileId" />
                    <div class="input-group">
                        <input type="text" name="rejectionReason" class="form-control" placeholder="Reason for rejection" required />
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            This institution has already been reviewed. No further action is available here.
        </div>
    }
</div>
