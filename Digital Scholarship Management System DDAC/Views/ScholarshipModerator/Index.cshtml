@{
    ViewData["Title"] = "Scholarship Moderator Dashboard";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h1 class="mb-1">Scholarship Moderator Dashboard</h1>
    <p class="text-muted mb-4">Signed in as @User.Identity?.Name</p>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Institutions</h5>
                    <p class="display-4 fw-bold text-primary mb-0">@ViewBag.PendingInstitutionsCount</p>
                    <p class="text-muted mb-3">awaiting review</p>
                    <p class="small text-muted mb-3">
                        <span class="text-success fw-bold">@ViewBag.ApprovedInstitutionsCount</span> approved &middot;
                        <span class="text-danger fw-bold">@ViewBag.RejectedInstitutionsCount</span> rejected
                    </p>
                    <a asp-action="Institutions" asp-route-statusFilter="PendingModeratorReview" class="btn btn-primary">Review Pending</a>
                    <a asp-action="Institutions" class="btn btn-outline-secondary">View All / Search</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Scholarship Listings</h5>
                    <p class="display-4 fw-bold text-primary mb-0">@ViewBag.PendingListingsCount</p>
                    <p class="text-muted mb-3">awaiting approval</p>
                    <p class="small text-muted mb-3">
                        <span class="text-success fw-bold">@ViewBag.ApprovedListingsCount</span> approved &middot;
                        <span class="text-danger fw-bold">@ViewBag.RejectedListingsCount</span> rejected
                    </p>
                    <a asp-action="Listings" asp-route-statusFilter="Pending" class="btn btn-primary">Review Pending</a>
                    <a asp-action="Listings" class="btn btn-outline-secondary">View All / Search</a>
                </div>
            </div>
        </div>
    </div>
</div>
